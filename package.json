{
  "name": "kloda",
  "private": true,
  "version": "0.0.0",
  "description": "Kloda: Secure Photos & Sync",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:mobile": "npm run dev --workspace=@kloda/mobile",
    "dev:desktop": "npm run dev --workspace=@kloda/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.1.0",
    "typescript-eslint": "^8.46.3"
  }
}
