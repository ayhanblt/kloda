{
  "name": "@kloda/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start --dev-client",
    "native:generate": "expo prebuild",
    "build": "expo export --platform ios && expo export --platform android",
