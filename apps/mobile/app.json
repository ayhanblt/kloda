{
  "expo": {
    "name": "Kloda: Secure Photos & Sync",
    "slug": "kloda",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "Allow Kloda to scan your computer pairing QR.",
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "barcodeScannerEnabled": true
      }]
    ],
    "ios": {
      "bundleIdentifier": "com.kloda.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kloda needs access to selected photos and albums so it can back them up to your personal storage."
      }
    },
    "android": {
      "package": "com.kloda.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    }
  }
}
