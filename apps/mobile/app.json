{
  "expo": {
    "name": "Kloda: Secure Photos & Sync",
    "slug": "kloda",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "./plugins/with-optional-camera.cjs",
      "./plugins/with-alert-case.cjs",
      "./plugins/with-live-activity.cjs",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kloda to scan your computer pairing QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.kloda.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kloda needs access to selected photos and albums so it can back them up to your personal storage.",
        "NSLocalNetworkUsageDescription": "Kloda connects to your computer on your local network for pairing and backup.",
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.kloda.app.backup.processing",
          "com.kloda.app.webdav.processing",
          "com.kloda.app.smb.processing",
          "com.kloda.app.sftp.processing",
          "com.kloda.app.ftps.processing",
          "com.kloda.app.s3.processing"
        ],
        "NSFaceIDUsageDescription": "Kloda asks for Face ID or your passcode before it shows your recovery code."
      }
    },
    "android": {
      "package": "com.kloda.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#1C1A18"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    }
  }
}
