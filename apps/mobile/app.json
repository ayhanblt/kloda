{
  "expo": {
    "name": "Kloda: Secure Photos & Sync",
    "slug": "kloda",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "./plugins/with-optional-camera.cjs",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kloda to scan your computer pairing QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.kloda.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kloda needs access to selected photos and albums so it can back them up to your personal storage.",
        "NSLocalNetworkUsageDescription": "Kloda connects to your computer on your local network for pairing and backup.",
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.kloda.app.backup.processing",
          "com.kloda.app.webdav.processing",
          "com.kloda.app.smb.processing",
          "com.kloda.app.sftp.processing"
        ]
      }
    },
    "android": {
      "package": "com.kloda.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    }
  }
}
