{
  "name": "@kloda/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/main.js",
  "productName": "Kloda: Secure Photos & Sync",
  "klodaDesktop": {
    "profile": "development",
    "applicationId": "com.kloda.desktop.dev"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:main && vite build",
    "build:main": "npm run build --workspace @kloda/sync-core && tsc -p tsconfig.main.json && node ../../tools/build-electron-sqlite.mjs && node ../../tools/build-native-desktop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,cts}\" vite.config.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@kloda/sync-core": "0.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.8.0",
    "i18next": "^26.4.2",
    "lucide-react": "1.52.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "sonner": "2.0.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.0.1"
  }
}
