  MConnectionsNewProviderRoute: typeof MConnectionsNewProviderRoute
  MConnectionsNewIndexRoute: typeof MConnectionsNewIndexRoute
}

const MRouteChildren: MRouteChildren = {
  MActivityRoute: MActivityRoute,
  MBackupsRoute: MBackupsRoute,
  MPairPcRoute: MPairPcRoute,
  MPairQrRoute: MPairQrRoute,
  MPhotosRoute: MPhotosRoute,
  MScheduleRoute: MScheduleRoute,
  MSettingsRoute: MSettingsRoute,
  MSourcesRoute: MSourcesRoute,
  MWelcomeRoute: MWelcomeRoute,
  MIndexRoute: MIndexRoute,
  MConnectionsIdRoute: MConnectionsIdRoute,
  MPhotoIdRoute: MPhotoIdRoute,
  MConnectionsIndexRoute: MConnectionsIndexRoute,
  MConnectionsNewProviderRoute: MConnectionsNewProviderRoute,
  MConnectionsNewIndexRoute: MConnectionsNewIndexRoute,
}

const MRouteWithChildren = MRoute._addFileChildren(MRouteChildren)

const rootRouteChildren: RootRouteChildren = {
  IndexRoute: IndexRoute,
  BrandRoute: BrandRoute,
  DRoute: DRouteWithChildren,
  LockScreenRoute: LockScreenRoute,
  MRoute: MRouteWithChildren,
}
export const routeTree = rootRouteImport
  ._addFileChildren(rootRouteChildren)
  ._addFileTypes<FileRouteTypes>()

import type { getRouter } from './router.tsx'
import type { startInstance } from './start.ts'
declare module '@tanstack/react-start' {
  interface Register {
    ssr: true
    router: Awaited<ReturnType<typeof getRouter>>
    config: Awaited<ReturnType<typeof startInstance.getOptions>>
  }
}
