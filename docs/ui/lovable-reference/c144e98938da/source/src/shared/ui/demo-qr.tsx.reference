/** Decorative, deterministic QR-like pattern. Not a real pairing code. */
export function DemoQr({ className, seed = 7 }: { className?: string; seed?: number }) {
  const n = 25;
  const cells: [number, number][] = [];
  let s = seed;
  const finder = (x: number, y: number) =>
    (x < 8 && y < 8) || (x > n - 9 && y < 8) || (x < 8 && y > n - 9);
  for (let y = 0; y < n; y++)
    for (let x = 0; x < n; x++) {
      s = (s * 9301 + 49297) % 233280;
      const center = x > 9 && x < 15 && y > 9 && y < 15;
      if (!finder(x, y) && !center && s / 233280 > 0.52) cells.push([x, y]);
    }
  const Finder = ({ x, y }: { x: number; y: number }) => (
    <g>
      <rect x={x} y={y} width="7" height="7" rx="1.6" className="fill-ink" />
      <rect x={x + 1} y={y + 1} width="5" height="5" rx="1" className="fill-card" />
      <rect x={x + 2} y={y + 2} width="3" height="3" rx="0.6" className="fill-ink" />
    </g>
  );
  return (
    <svg viewBox={`-1 -1 ${n + 2} ${n + 2}`} className={className} role="img" aria-label="Demo QR">
      <rect x="-1" y="-1" width={n + 2} height={n + 2} rx="2" className="fill-card" />
      {cells.map(([x, y]) => (
        <rect key={`${x}-${y}`} x={x + 0.08} y={y + 0.08} width="0.84" height="0.84" rx="0.2" className="fill-ink" />
      ))}
      <Finder x={0} y={0} />
      <Finder x={n - 7} y={0} />
      <Finder x={0} y={n - 7} />
      <g transform="translate(9.5 9.5) scale(0.05)">
        <rect width="120" height="120" rx="26" className="fill-tile" />
        <circle cx="60" cy="60" r="26" strokeWidth="10" strokeLinecap="round" strokeDasharray="122 41" transform="rotate(-90 60 60)" fill="none" className="stroke-tile-ring" />
        <circle cx="60" cy="60" r="7" className="fill-brand" />
      </g>
    </svg>
  );
}
