/** Vector hero: phone → sync ring → computer, with floating photo tiles. Decorative. */
export function WelcomeIllustration({ className }: { className?: string }) {
  return (
    <svg viewBox="0 0 360 300" fill="none" className={className} aria-hidden>
      {/* orbit rings */}
      <circle cx="180" cy="150" r="128" className="stroke-border animate-orbit" strokeWidth="1.5" strokeDasharray="2 10" />
      <circle cx="180" cy="150" r="96" className="stroke-border" strokeWidth="1" />
      <circle cx="180" cy="150" r="70" className="fill-brand animate-halo" opacity="0.15" />

      {/* data path */}
      <path d="M78 170 C 120 100, 240 100, 282 170" className="stroke-synced animate-dash" strokeWidth="2.5" strokeLinecap="round" />

      {/* phone */}
      <g className="animate-float">
        <rect x="46" y="128" width="64" height="112" rx="14" className="fill-card stroke-border" strokeWidth="2" />
        <rect x="54" y="140" width="48" height="80" rx="6" className="fill-muted" />
        <rect x="58" y="146" width="18" height="18" rx="3" className="fill-syncing" opacity="0.7" />
        <rect x="80" y="146" width="18" height="18" rx="3" className="fill-synced" opacity="0.7" />
        <rect x="58" y="168" width="18" height="18" rx="3" className="fill-review" opacity="0.6" />
        <rect x="80" y="168" width="18" height="18" rx="3" className="fill-pending" opacity="0.5" />
        <rect x="58" y="190" width="40" height="6" rx="3" className="fill-border" />
        <rect x="68" y="228" width="20" height="4" rx="2" className="fill-border" />
      </g>

      {/* laptop */}
      <g className="animate-float-slow">
        <rect x="238" y="136" width="96" height="66" rx="8" className="fill-card stroke-border" strokeWidth="2" />
        <rect x="246" y="144" width="80" height="50" rx="4" className="fill-muted" />
        <rect x="252" y="150" width="30" height="5" rx="2.5" className="fill-ink" opacity="0.7" />
        <rect x="252" y="160" width="50" height="4" rx="2" className="fill-border" />
        <rect x="252" y="170" width="68" height="6" rx="3" className="fill-synced-soft" />
        <rect x="252" y="170" width="44" height="6" rx="3" className="fill-synced" />
        <path d="M226 206 H346 L338 214 H234 Z" className="fill-border" />
      </g>

      {/* center app icon */}
      <g>
        <rect x="140" y="86" width="80" height="80" rx="20" className="fill-tile" />
        <circle cx="180" cy="126" r="20" className="stroke-tile-ring logo-ring-draw" strokeWidth="7" strokeLinecap="round" transform="rotate(-90 180 126)" strokeDasharray="94 32" />
        <circle cx="180" cy="126" r="5.5" className="fill-brand" />
      </g>

      {/* floating tiles */}
      <g className="animate-float">
        <rect x="128" y="36" width="34" height="34" rx="8" className="fill-card stroke-border" strokeWidth="1.5" />
        <circle cx="138" cy="47" r="4" className="fill-syncing" />
        <path d="M132 64 L142 54 L150 61 L156 56 L160 64 Z" className="fill-synced" opacity="0.8" />
      </g>
      <g className="animate-float-slow">
        <rect x="214" y="30" width="28" height="28" rx="7" className="fill-card stroke-border" strokeWidth="1.5" />
        <path d="M221 44 l5 5 l9 -10" className="stroke-synced" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
      </g>
      <g className="animate-float-slow">
        <rect x="160" y="236" width="40" height="22" rx="11" className="fill-card stroke-border" strokeWidth="1.5" />
        <circle cx="172" cy="247" r="3.5" className="fill-synced" />
        <rect x="179" y="245" width="14" height="4" rx="2" className="fill-border" />
      </g>
    </svg>
  );
}
