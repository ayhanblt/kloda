import type { ReactNode } from "react";
import { cn } from "@/lib/utils";

/** Section header used by Status/Activity: bold label, optional count and trailing action. */
export function GroupHeading({ children, count, action }: { children: ReactNode; count?: number; action?: ReactNode }) {
  return <div className="mb-2 mt-7 flex items-center justify-between gap-2 px-1">
    <h2 className="flex items-center gap-2 text-[17px] font-semibold leading-6">{children}{count !== undefined && <span className="grid h-5 min-w-5 place-items-center rounded-full bg-surface-2 px-1.5 text-caption tabular-nums">{count}</span>}</h2>
    {action}
  </div>;
}

/** One-level grouped list container with hairline separators. */
export function Group({ children, className }: { children: ReactNode; className?: string }) {
  return <div className={cn("overflow-hidden rounded-2xl border border-border-subtle bg-surface-1 shadow-card [&>*+*]:border-t [&>*+*]:border-border-subtle", className)}>{children}</div>;
}

/** Kloda ring mark used as the Status tab icon. */
export function RingIcon({ className }: { className?: string }) {
  return <svg viewBox="0 0 24 24" className={className} aria-hidden fill="none">
    <circle cx="12" cy="12" r="8" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeDasharray="38 12" transform="rotate(-90 12 12)" />
    <circle cx="12" cy="12" r="2.5" fill="currentColor" />
  </svg>;
}
