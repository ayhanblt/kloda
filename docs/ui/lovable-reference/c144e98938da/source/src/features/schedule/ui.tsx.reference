import { useState } from "react";
import { CalendarClock, Hand, Zap } from "lucide-react";
import { toast } from "sonner";
import { useI18n } from "@/shared/i18n";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Switch } from "@/components/ui/switch";
import { Notice, Row, SectionTitle } from "@/shared/ui/kit";
import { cn } from "@/lib/utils";

export function ScheduleControls() {
  const { t } = useI18n();
  const [mode, setMode] = useState("live");
  const [days, setDays] = useState([0, 1, 2, 3, 4]);
  const [time, setTime] = useState("02:00");
  const options = [
    { id: "live", icon: Zap, title: t.schedule.live, body: t.schedule.liveBody },
    { id: "scheduled", icon: CalendarClock, title: t.schedule.scheduled, body: t.schedule.scheduledBody },
    { id: "manual", icon: Hand, title: t.schedule.manual, body: t.schedule.manualBody },
  ];
  return <div className="space-y-3">
    <div className="space-y-2" aria-label={t.schedule.title}>
      {options.map(({ id, icon: Icon, title, body }) => <Button key={id} variant="ghost" aria-pressed={mode === id} onClick={() => setMode(id)} className={cn("h-auto w-full justify-start gap-3 rounded-2xl border p-4 text-left", mode === id ? "border-ink bg-card shadow-card" : "border-border bg-card/60")}>
        <Icon className="size-5 shrink-0 text-secondary-text"/>
        <span className="min-w-0 flex-1"><span className="block font-semibold text-ink">{title}</span><span className="mt-1 block text-xs font-normal text-muted-foreground">{body}</span></span>
        <span className={cn("size-5 shrink-0 rounded-full border-4", mode === id ? "border-ink bg-background" : "border-muted bg-muted")} aria-hidden />
      </Button>)}
    </div>
    {mode === "live" && <Notice>{t.schedule.liveLimit}</Notice>}
    {mode === "scheduled" && <div className="rounded-2xl border border-border bg-card p-4">
      <SectionTitle>{t.schedule.days}</SectionTitle>
      <div className="grid grid-cols-7 gap-1">{t.schedule.weekdays.map((d, i) => <Button key={d} variant="ghost" aria-pressed={days.includes(i)} onClick={() => setDays(v => v.includes(i) ? v.filter(x => x !== i) : [...v, i])} className={cn("min-w-0 rounded-full px-0 text-xs", days.includes(i) ? "bg-ink text-background hover:bg-ink hover:text-background" : "bg-muted")}>{d}</Button>)}</div>
      <label className="mt-4 block text-sm font-medium">{t.schedule.time}<Input className="mt-2 min-h-12" type="time" value={time} onChange={e => setTime(e.target.value)} /></label>
    </div>}
    <div className="rounded-2xl border border-border bg-card p-1">
      <Row title={t.schedule.wifiOnly} trailing={<Switch defaultChecked aria-label={t.schedule.wifiOnly} />} />
      <Row title={t.schedule.charging} trailing={<Switch aria-label={t.schedule.charging} />} />
    </div>
    <Notice>{t.schedule.changeWarning}</Notice>
    <Button variant="secondary" className="w-full" onClick={() => toast(t.schedule.saved)}>{t.common.save}</Button>
  </div>;
}