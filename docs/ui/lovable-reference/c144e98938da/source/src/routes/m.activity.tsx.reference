    meta: [
      { property: "og:type", content: "website" },
      { name: "twitter:card", content: "summary_large_image" },
      { title: "Etkinlik — Kloda" },
      { name: "description", content: "Kloda prototipi: Etkinlik." },
      { property: "og:title", content: "Etkinlik — Kloda" },
      { property: "og:description", content: "Kloda prototipi: Etkinlik." },
    ],
  }),
  component: MobileActivity,
});
