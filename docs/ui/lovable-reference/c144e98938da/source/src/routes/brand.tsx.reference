import { useState } from "react";
import { createFileRoute, Link } from "@tanstack/react-router";
import { ArrowLeft, Play } from "lucide-react";
import { useI18n } from "@/shared/i18n";
import { AppIcon, LogoSymbol, TrayIcon, Wordmark } from "@/shared/ui/logo";
import { Panel, SectionTitle, StatusPill } from "@/shared/ui/kit";
import { Button } from "@/components/ui/button";

export const Route = createFileRoute("/brand")({
  head: () => ({
    meta: [
      { property: "og:type", content: "website" },
      { name: "twitter:card", content: "summary_large_image" },
      { title: "Logo ve tokenlar — Kloda" },
      { name: "description", content: "Kloda logo varyantları, renk, tipografi ve hareket tokenları." },
      { property: "og:title", content: "Logo ve tokenlar — Kloda" },
      { property: "og:description", content: "Kloda logo varyantları ve tasarım tokenları." },
    ],
  }),
  component: Brand,
});

const swatches = [
  ["bg-background", "background"], ["bg-surface", "surface"], ["bg-card", "card"], ["bg-border", "border"],
  ["bg-ink", "ink"], ["bg-ink-soft", "ink-soft"], ["bg-tile", "brand"], ["bg-brand", "signal"],
  ["bg-synced", "synced"], ["bg-syncing", "syncing"], ["bg-pending", "pending"], ["bg-danger", "danger"], ["bg-review", "review"],
];

function Brand() {
  const { t } = useI18n();
  const [k, setK] = useState(0);
  return (
    <main className="mx-auto max-w-5xl px-6 py-8">
      <Link to="/" className="mb-4 inline-flex min-h-12 items-center gap-2 text-sm text-ink-soft"><ArrowLeft className="size-4" />Kloda</Link>
      <h1 className="text-[32px] font-semibold tracking-tight text-ink">{t.brand.title}</h1>
      <div className="mt-6 grid gap-4 md:grid-cols-3">
        <Panel className="grid place-items-center gap-3 py-8"><AppIcon className="size-28" /><span className="text-xs text-muted-foreground">{t.brand.appIcon}</span></Panel>
        <Panel className="grid place-items-center gap-3 py-8"><LogoSymbol tone="dark" className="size-28" /><span className="text-xs text-muted-foreground">{t.brand.symbol} · {t.brand.onLight}</span></Panel>
        <Panel className="grid place-items-center gap-3 bg-tile py-8"><LogoSymbol tone="light" className="size-28" /><span className="text-xs text-tile-foreground/70">{t.brand.symbol} · {t.brand.onDark}</span></Panel>
        <Panel className="grid place-items-center gap-3 py-8"><Wordmark size="lg" /><span className="text-xs text-muted-foreground">{t.brand.lockup}</span></Panel>
        <Panel className="grid place-items-center gap-3 bg-tile py-8"><Wordmark size="lg" inverse /><span className="text-xs text-tile-foreground/70">{t.brand.lockup} · {t.brand.onDark}</span></Panel>
        <Panel className="grid place-items-center gap-3 py-8">
          <div className="flex gap-4 text-ink"><LogoSymbol tone="mono" className="size-20" /><span className="grid place-items-center rounded-xl bg-ink p-1 text-card"><LogoSymbol tone="mono-inverse" className="size-16" /></span></div>
          <span className="text-xs text-muted-foreground">{t.brand.mono}</span>
        </Panel>
        <Panel className="grid place-items-center gap-3 py-8">
          <div className="flex items-end gap-4 text-ink"><TrayIcon className="size-4" /><TrayIcon className="size-5" /><TrayIcon className="size-6" /><AppIcon className="size-8" /><AppIcon className="size-12" /></div>
          <span className="text-xs text-muted-foreground">{t.brand.tray} · 16–48 px</span>
        </Panel>
        <Panel className="grid place-items-center gap-3 py-8 md:col-span-2">
          <AppIcon key={k} animated className="size-24" />
          <p className="max-w-md text-center text-xs text-muted-foreground">{t.brand.motionBody}</p>
          <Button size="sm" variant="secondary" onClick={() => setK((x) => x + 1)}><Play /> {t.brand.replay}</Button>
        </Panel>
      </div>
      <SectionTitle>{t.brand.colors}</SectionTitle>
      <div className="grid grid-cols-3 gap-3 sm:grid-cols-5 lg:grid-cols-7">
        {swatches.map(([c, n]) => (
          <div key={n}><div className={`h-16 rounded-xl border border-border ${c}`} /><p className="mt-1 font-mono text-[11px] text-muted-foreground">{n}</p></div>
        ))}
      </div>
      <SectionTitle>{t.brand.type}</SectionTitle>
      <Panel className="space-y-2">
        <p className="text-[40px] font-semibold leading-tight tracking-tight">Inter 40 / 600</p>
        <p className="text-[28px] font-semibold tracking-tight">Headline 28 / 600</p>
        <p className="text-lg font-semibold">Headline 18 / 600</p>
        <p className="text-sm">Body 14 / 400 — Fotoğrafların, senin bilgisayarında.</p>
        <p className="text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">Label 11 / 600</p>
        <div className="flex flex-wrap gap-2 pt-2">
          <StatusPill tone="synced">synced</StatusPill><StatusPill tone="syncing">syncing</StatusPill><StatusPill tone="pending">pending</StatusPill><StatusPill tone="review">review</StatusPill><StatusPill tone="danger">error</StatusPill>
        </div>
      </Panel>
    </main>
  );
}
