      { title: "Durum — Kloda" },
      { name: "description", content: "Kloda yedekleme durumu, hedefler ve son etkinlikler." },
      { property: "og:title", content: "Durum — Kloda" },
      { property: "og:description", content: "Kloda yedekleme durumu, hedefler ve son etkinlikler." },
    ],
  }),
  component: MobileStatus,
