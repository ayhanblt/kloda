+def _settle(root, supervisor_exit, cli_interrupted=False):
+    """The supervisor's result is provisional. Only this CLI, uninterrupted, holding the run lock, seeing the
+    same result generation as before the lock and the exact exit code of that result, confirms it by writing
+    run ID + generation + exit atomically. Anything else leaves it unconfirmed: cleanup-verified FAIL."""
