listen=YES
listen_ipv6=NO
listen_port=27449
background=NO
anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=077
chroot_local_user=YES
allow_writeable_chroot=YES
local_root=/srv/ftp/upload
pam_service_name=vsftpd
pasv_enable=YES
pasv_min_port=27450
pasv_max_port=27450
pasv_address=127.0.0.1
ssl_enable=YES
force_local_logins_ssl=YES
force_local_data_ssl=YES
allow_anon_ssl=NO
ssl_tlsv1=NO
ssl_sslv2=NO
ssl_sslv3=NO
rsa_cert_file=/run/kloda/server.pem
rsa_private_key_file=/run/kloda/server.key
require_ssl_reuse=NO
