package com.kloda.sync

import android.content.SharedPreferences
import java.util.UUID

// OS port: real JobScheduler in production/harness, deterministic fake in component tests.
internal interface S3AutoOs {
  fun schedule(wake: String, nonce: String, latency: Long, protocol: Int): Int
  fun cancel()
  // null = verified absent; a throw = unknown (never treated as absent).
  fun pending(): Map<String, Any?>?
}
internal class S3AutoLease(val begin: (Any) -> Boolean, val end: (Any) -> Unit)

/**
 * Single owner of plan state, queue admission, the execution lease and OS projection.
 * Decisions are serialized on AndroidSyncJournal.sourceLock; OS calls run only on the main
 * lane outside that monitor; DB/queue preparation runs on the background executor.
 * A delivered envelope is only a candidate until the background lane proves its wake current;
 * a stale candidate finishes only itself and never touches the owner, lease or another execution.
 */
internal class AndroidS3AutomaticCoordinator(private val os: S3AutoOs, private val main: (Runnable) -> Unit, private val background: (Runnable) -> Unit,
  private val clock: () -> Long, private val locked: () -> Boolean, private val lease: S3AutoLease, val queue: AndroidS3Queue,
  val plan: AndroidS3AutomaticPlan, private val legacy: SharedPreferences, private val paused: () -> Boolean, private val next: (Long) -> Long) {
  enum class Owner { IDLE, EXECUTING, REPLACING, HANDING, OS_OWNED, STORAGE_BLOCKED }
  // One JobService execution: exact params identity, wake envelope (null = legacy) and epoch at entry.
  class Exec(val params: Any, val service: Any?, val wake: String?, val epoch: Long, val extras: Map<String, Any?>, val finish: (Boolean) -> Unit) {
    // carry = plan revised by this execution's own fold (R9); its exact stop projects it once.
    // resume = terminal run completion: its outcome continues a recorded clock request.
    var state = "candidate"; var runId: String? = null; var buffered: S3Run? = null; var carry: S3AutoPlan? = null; var resume = false
  }
  // Explicit clock/timezone request, RAM only and bound to its epoch; proof = revision written under a lost ack.
  // R14: proof = the exact (old, new) CAS pair; committed = its proven commit event, bound before any arm can refresh it.
  private class Clock(val epoch: Long) { var proof: Pair<S3AutoPlan, S3AutoPlan>? = null; var committed: S3AutoPlan? = null }
  // One projection request: wake, absolute eligible time and envelope protocol (0 = legacy recovery).
  private sealed class Out { class Replace(val wake: String, val at: Long, val protocol: Int = 1) : Out(); object Cancel : Out(); object Finish : Out() }
  private val lock = AndroidSyncJournal.sourceLock
  var epoch = 0L; private set
  var owner = Owner.IDLE; private set
  var dirty = false; private set
  var unresolved = false; private set
  var blocked = false; private set
  private var blockedAttempt: S3Attempt? = null; private var exec: Exec? = null
  private val candidates = ArrayList<Exec>()
  // Last proven SQLite wake. Unknown (not read / read failure) never authorizes an OS retry.
  // ticket = current projection authority (R13): a fresh RAM identity per projection; the owner enum alone is not authority.
  private var planWake: String? = null; private var wakeKnown = false; private var clockReq: Clock? = null; private var ticket: Any? = null
  val clockPending: Boolean get() = synchronized(lock) { clockReq?.epoch == epoch }
  init { queue.attach(plan); runCatching { read() } }
  private fun halted(e: Exec) = e.state == "stopped" || e.state == "done"
  private fun active() = exec?.takeIf { !halted(it) && it.state != "unresolved" }
  private fun read(): S3AutoPlan? = try { seen(plan.current()) } catch (error: Exception) { synchronized(lock) { wakeKnown = false }; throw error }
  private fun seen(p: S3AutoPlan?): S3AutoPlan? = p.also { synchronized(lock) { planWake = p?.wake; wakeKnown = true } }
  private fun out(p: S3AutoPlan) = Out.Replace(p.wake!!, p.eligibleAt())

  fun onStart(params: Any, service: Any?, extras: Map<String, Any?>, finish: (Boolean) -> Unit): Boolean {
    val wake = (extras["wake"] as? String)?.takeIf { extras["protocol"] == 1 && extras["provider"] == "amazon-s3" }
    val e = synchronized(lock) {
      if (exec?.params === params || candidates.any { it.params === params }) return false
      Exec(params, service, wake, epoch, extras, finish).also { candidates.add(it) }
    }
    background(Runnable { evaluate(e) })
    return true
  }
  private fun evaluate(e: Exec) {
    val p = if (e.wake == null) null else runCatching { read() }.getOrNull()
    // R8: a legacy/invalid envelope must be proven current (no marker, own snapshot) before any ownership change.
    when (install(e, p, e.wake == null && legacyCurrent(e.extras))) {
      null -> return
      false -> { main(Runnable { e.finish(false) }); return }
      true -> Unit
    }
    val out = try { if (p == null) recover(e.extras) else admit(e, p) } catch (_: Exception) { lease.end(e); fence(); Out.Finish }
    if (out != null) complete(e, out)
  }
  // null = stopped before validation (onStop already chose the OS handoff); false = stale, finishes only itself
  // and never touches owner, epoch, wake, unresolved or the current execution.
  private fun install(e: Exec, p: S3AutoPlan?, legacyOk: Boolean): Boolean? = synchronized(lock) {
    candidates.remove(e)
    if (halted(e)) return@synchronized null
    if (e.epoch != epoch || active() != null || (if (e.wake == null) !legacyOk else p?.wake != e.wake)) { e.state = "done"; return@synchronized false }
    exec?.state = "done"; exec = e; owner = Owner.EXECUTING; unresolved = false; e.state = "starting"; true
  }
  private fun admit(e: Exec, current: S3AutoPlan): Out? {
    val now = clock(); if (synchronized(lock) { blocked }) return Out.Finish
    // Early wake (R12): gated on the current plan before the dirty fold, so no lease, authority capture,
    // source binding or admission; the same retryNotBefore is kept. A recorded clock request is not started here.
    if (now < current.eligibleAt()) return out(current)
    // A deferred ordinary (config/context) note joins this eligible execution's single outcome.
    val p = fold(e, current); if (p.wake == null) return Out.Cancel
    // A fold that moved the plan later is still early for the revised plan.
    if (now < p.eligibleAt()) return out(p)
    if (paused()) return terminal()
    if (locked()) return defer(p, now)
    val nextDue = next(now); val began = synchronized(lock) { if (halted(e)) return null; lease.begin(e) }; if (!began) return defer(p, now)
    return when (val result = queue.startAutomatic(p, plan, e, nextDue) { run -> onRun(e, run) }) {
      is S3Admission.Accepted -> { accepted(e, result.runId); null }
      is S3Admission.NotAccepted -> { lease.end(e); rejected(e, p, result.reason, now) }
      is S3Admission.OutcomeUnknown -> { synchronized(lock) { if (!halted(e)) e.state = "resolving" }; resolve(e, result.attempt) }
    }
  }
  // R9: the revision commits under sourceLock only while this execution still owns the outcome, and is
  // carried by it; a stop serialized before the commit keeps dirty for the next owner instead.
  // Capture runs on this background lane outside sourceLock; only the decision/commit is under it.
  private fun fold(e: Exec, p: S3AutoPlan): S3AutoPlan {
    if (!synchronized(lock) { dirty && !halted(e) } || locked()) return p
    val authority = runCatching { queue.authority() }.getOrElse { return p }
    return synchronized(lock) {
      if (!dirty || halted(e) || runCatching { plan.arm(authority, clock(), next, false) }.isFailure) return@synchronized p
      dirty = false; (read() ?: p).also { e.carry = it }
    }
  }
  // Legacy/old envelope: reevaluation only, never admission. Locked keeps one >=5 min continuation.
  private fun recover(extras: Map<String, Any?>): Out {
    if (plan.marked()) return Out.Finish; if (paused()) return Out.Cancel
    val snapshot = AndroidS3AutomaticPlan.legacySnapshot(legacy)
    if (extras["protocol"] == 0 && extras["wake"] != snapshot) return Out.Finish
    var authority: S3AutoAuthority? = null; var open = !locked()
    if (open) try { authority = queue.authority() } catch (error: Exception) { if (AndroidS3Queue.code(error) != "credential_locked") throw error; open = false }
    if (!open) return Out.Replace(snapshot ?: return Out.Finish, maxOf(Math.addExact(clock(), DEFER), legacy.getLong("due", 0)), 0)
    plan.migrate(legacy, authority, clock(), next)
    return when (val result = plan.arm(authority, clock(), next, false)) {
      S3Refresh.Revoked -> { seen(null); Out.Cancel }
      is S3Refresh.Updated -> out(seen(result.plan)!!)
      is S3Refresh.Same -> out(seen(result.plan)!!)
    }
  }
  private fun accepted(e: Exec, runId: String) {
    val (stop, drain) = synchronized(lock) {
      e.runId = runId; if (e.state == "starting") e.state = "running"
      val value = e.buffered; e.buffered = null; halted(e) to value
    }
    if (stop) runCatching { queue.pauseAutomatic(e, runId) }; if (drain == null) return
    if (drain.id == runId) finished(e) else { synchronized(lock) { blocked = true }; lease.end(e); complete(e, Out.Finish) }
  }
  private fun onRun(e: Exec, run: S3Run) {
    val ready = synchronized(lock) { if (e.state == "done" || e.state == "completing") false else if (e.runId == null) { if (e.buffered == null) e.buffered = run; false } else e.runId == run.id }
    if (ready) finished(e)
  }
  private fun finished(e: Exec) {
    val stopped = synchronized(lock) { val value = halted(e); e.state = if (value) "done" else "completing"; e.resume = !value; value }
    lease.end(e)
    if (!stopped) background(Runnable { complete(e, project(e)) })
  }
  private fun project(e: Exec): Out = try { read()?.let { fold(e, it) }?.takeIf { it.wake != null }?.let(::out) ?: Out.Cancel } catch (_: Exception) { Out.Finish }
  private fun rejected(e: Exec, p: S3AutoPlan, reason: String, now: Long): Out {
    if (synchronized(lock) { e.buffered != null }) { synchronized(lock) { blocked = true }; return Out.Finish }
    return when (reason) {
      "backup_busy", "credential_locked" -> defer(p, now)
      "candidate_stale" -> if (locked()) defer(p, now) else refresh(p, now)
      "storage_failure" -> terminal()
      else -> refresh(p, now)
    }
  }
  private fun refresh(p: S3AutoPlan, now: Long): Out {
    val result = try { plan.arm(queue.authority(), clock(), next, false) } catch (error: Exception) {
      return if (locked() || AndroidS3Queue.code(error) == "credential_locked") defer(p, now) else terminal()
    }
    return when (result) {
      is S3Refresh.Updated -> out(seen(result.plan)!!)
      is S3Refresh.Same -> if (result.plan != p) out(result.plan) else terminal()
      S3Refresh.Revoked -> { seen(null); Out.Cancel }
    }
  }
  // No blind retry: disarm and cancel; a failed disarm becomes a storage gate.
  private fun terminal(): Out = try { plan.disarm(); seen(null); Out.Cancel }
    catch (_: Exception) { synchronized(lock) { blocked = true }; Out.Finish }
  private fun defer(p: S3AutoPlan, now: Long): Out = try { out(plan.defer(p, Math.addExact(now, DEFER))) } catch (_: Exception) {
    val latest = runCatching { read() }.getOrNull()
    if (latest?.wake != null && latest != p) out(latest) else Out.Finish
  }
  private fun resolve(e: Exec, attempt: S3Attempt): Out {
    val result = queue.resolveAutomatic(attempt, plan); lease.end(e)
    return when (result) {
      is S3Resolution.ResolvedAccepted -> project(e)
      S3Resolution.ResolvedNotAccepted -> terminal()
      S3Resolution.Unresolved -> { synchronized(lock) { blocked = true; blockedAttempt = attempt }; Out.Finish }
    }
  }
  private fun complete(e: Exec, out: Out) = main(Runnable { apply(e, out) })
  private fun apply(e: Exec, out: Out) {
    val t = synchronized(lock) {
      if (exec !== e || halted(e) || e.epoch != epoch) { e.state = "done"; return }
      e.state = "completing"; if (out is Out.Replace) claim() else null
    }
    when (out) {
      is Out.Replace -> replace(e, t!!, out)
      Out.Cancel -> { done(e, Owner.IDLE); e.finish(false); val at = synchronized(lock) { epoch }; if (at == e.epoch) os.cancel() }
      Out.Finish -> { done(e, if (blocked) Owner.STORAGE_BLOCKED else Owner.IDLE); e.finish(false) }
    }
    if (e.resume) resume()
  }
  private fun done(e: Exec, value: Owner) = synchronized(lock) { e.state = "done"; owner = value }
  private fun claim(): Any = Any().also { ticket = it; owner = Owner.REPLACING } // under sourceLock, before the OS call
  // One uncertainty protocol for every projection: a generic throw counts only with the exact new nonce.
  private fun submit(out: Out.Replace): Int? {
    val nonce = UUID.randomUUID().toString()
    return try { os.schedule(out.wake, nonce, maxOf(0L, out.at - clock()), out.protocol) } catch (_: Exception) {
      if (runCatching { os.pending()?.get("nonce") == nonce }.getOrDefault(false)) SUCCESS else null
    }
  }
  // Schedule-as-completion: SUCCESS replaces the running job and no jobFinished follows.
  // R13: the result applies only under the exact ticket; a superseded (retired) execution writes and finishes nothing.
  private fun replace(e: Exec, t: Any, out: Out.Replace) {
    val result = submit(out)
    synchronized(lock) {
      if (ticket !== t) { e.state = "done"; return }; ticket = null
      // Unknown schedule outcome: no second schedule or finish(true); only an exact onStop closes it.
      if (result == null) { e.state = "unresolved"; owner = Owner.OS_OWNED; unresolved = true } else { e.state = "done"; owner = if (result == SUCCESS) Owner.OS_OWNED else Owner.HANDING }
    }
    if (result != null && result != SUCCESS) { e.finish(true); synchronized(lock) { if (owner == Owner.HANDING) owner = Owner.OS_OWNED } }
  }

  fun onStop(params: Any): Boolean {
    var relay: S3AutoPlan? = null; var at = 0L; var t: Any? = null
    val (e, retry, installed) = synchronized(lock) {
      val installed = exec?.takeIf { it.params === params }
      val e = installed ?: candidates.firstOrNull { it.params === params } ?: return false
      if (halted(e)) return false
      val open = e.state != "unresolved" && e.epoch == epoch && !blocked && !unresolved && (installed != null || active() == null) && wakeKnown && !paused()
      // R9: this execution's fold revised the plan; the old envelope is stale, so the revised wake is projected once.
      relay = e.carry?.takeIf { open && it.wake != null && it.wake != e.wake && it.wake == planWake }
      // A stop before validation hands off only for the proven current wake and when no other owner exists.
      val retry = open && relay == null && (if (e.wake != null) planWake == e.wake else planWake == null && legacyCurrent(e.extras))
      e.state = "stopped"; at = epoch
      // R13: lifecycle identity is not projection authority; an old-epoch stop never writes the current owner.
      if (installed != null && e.epoch == at || retry) owner = when { relay != null -> Owner.REPLACING; retry || unresolved -> Owner.OS_OWNED; blocked -> Owner.STORAGE_BLOCKED; else -> Owner.IDLE }
      if (relay != null) t = claim(); Triple(e, retry, installed != null)
    }
    if (installed) { lease.end(e); background(Runnable { runCatching { queue.pauseAutomatic(e, e.runId) } }) }
    relay?.let { p -> val tk = t!!; main(Runnable { schedule(at, tk, out(p)) }) }
    if (installed && e.epoch == at) resume()
    return retry
  }
  // A legacy envelope is current only before the marker and while its own snapshot (protocol 0) or a
  // pre-protocol job's data still exists; an invalid protocol-1 envelope is never legacy.
  private fun legacyCurrent(x: Map<String, Any?>) = runCatching { !plan.marked() }.getOrDefault(false) &&
    AndroidS3AutomaticPlan.legacySnapshot(legacy)?.let { x["protocol"] == null || x["protocol"] == 0 && x["wake"] == it } == true
  fun onDestroy(service: Any) {
    val e = synchronized(lock) {
      candidates.filter { it.service === service }.forEach { it.state = "stopped" }
      exec?.takeIf { it.service === service && !halted(it) && it.state != "unresolved" }?.also { it.state = "stopped"; if (owner == Owner.EXECUTING) owner = Owner.IDLE }
    } ?: return
    lease.end(e)
    background(Runnable { runCatching { queue.pauseAutomatic(e, e.runId) } })
  }

  // Foreground/receiver/settings entry point; never bypasses eligibleAt or an OS-owned backoff.
  fun reconcile(changed: Boolean = false) {
    if (paused()) { revoke(); return }
    // Only the explicit clock/timezone event records a request, before every guard; coalesced per epoch.
    if (changed) synchronized(lock) { if (clockReq?.epoch != epoch) clockReq = Clock(epoch) }
    if (!unblock()) return
    if (locked()) { lockedProjection(); return }
    val authority = try { queue.authority() } catch (_: Exception) { return }
    try {
      // A fresh unlocked migration replaces any legacy-recovery job with the protocol=1 projection.
      val migrated = !plan.marked()
      plan.migrate(legacy, authority, clock(), next)
      when (val result = plan.arm(authority, clock(), next, false)) {
        S3Refresh.Revoked -> revoke()
        is S3Refresh.Updated -> { seen(result.plan); if (result.rotated || migrated) revision(result.plan) else if (!revise(authority)) idleProject(result.plan) }
        is S3Refresh.Same -> { seen(result.plan); if (migrated) revision(result.plan) else if (!revise(authority)) idleProject(result.plan) }
      }
    } catch (_: Exception) { fence() }
  }
  // Recorded clock request: only with no execution/projection in flight, no fence and same configuration. Exact
  // CAS under sourceLock keeps the wake (new occurrence/due); epoch++ fences older executions; one projection.
  private fun revise(authority: S3AutoAuthority?): Boolean {
    val (at, p, t) = synchronized(lock) {
      val r = clockReq?.takeIf { it.epoch == epoch } ?: run { clockReq = null; return false }
      if (authority == null || active() != null || blocked || unresolved || owner != Owner.IDLE && owner != Owner.OS_OWNED) return false
      val current = read()
      if (current?.wake == null || current.target != authority.target || current.binding != authority.binding) { clockReq = null; return false }
      // Committed R: the fresh (possibly context-refreshed) row keeps R's due/wake/retry; no second CAS or next(now).
      val done = r.committed?.also { if (current.due != it.due || current.wake != it.wake || current.retry != it.retry || current.context != authority.context) { clockReq = null; return false } }
      val revised = done?.let { current } ?: current.copy(occurrence = UUID.randomUUID().toString(), context = authority.context, due = next(clock()), retry = null)
      if (done == null) { r.proof = current to revised; if (!plan.clock(current, revised)) return false }
      seen(revised); clockReq = null; epoch++; Triple(epoch, revised, claim())
    }
    main(Runnable { schedule(at, t, out(p)) })
    return true
  }
  // Separate authorized continuation after a terminal completion, exact stop or projection; never an OS delivery.
  private fun resume() { if (synchronized(lock) { clockReq?.epoch == epoch }) background(Runnable { if (!locked() && !paused()) try { revise(queue.authority()) } catch (_: Exception) { fence() } }) }
  // An uncertain migration acknowledgment is a storage gate until settle() proves it.
  private fun fence() { if (plan.fenced) synchronized(lock) { blocked = true; if (owner == Owner.IDLE) owner = Owner.STORAGE_BLOCKED } }
  private fun unblock(): Boolean {
    val attempt = synchronized(lock) { if (!blocked) return true; blockedAttempt }
    // A clock result binds only to its exact request (epoch + old/new pair); rolled back = no commit yet, CAS may retry.
    val ok = if (attempt != null) queue.resolveAutomatic(attempt, plan) != S3Resolution.Unresolved else runCatching { when (val s = plan.settle(legacy)) {
      is S3Settle.ClockCommitted -> synchronized(lock) { clockReq?.takeIf { it.epoch == epoch && it.proof == s.expected to s.revised }?.committed = s.revised }
      is S3Settle.ClockRolledBack -> Unit; else -> plan.disarm() } }.isSuccess
    if (ok) synchronized(lock) { blocked = false; blockedAttempt = null; if (owner == Owner.STORAGE_BLOCKED) owner = Owner.IDLE }
    return ok
  }
  // Revocation does not wait: epoch++, wake disarm, exact stop, epoch-tagged cancel.
  fun revoke() {
    val (e, at) = synchronized(lock) {
      epoch++; unresolved = false; dirty = false; ticket = null
      val e = exec?.takeIf { !halted(it) }?.also { it.state = "done" }
      if (owner != Owner.STORAGE_BLOCKED) owner = Owner.IDLE; e to epoch
    }
    e?.let { lease.end(it); runCatching { queue.pauseAutomatic(it, it.runId) } }
    if (runCatching { plan.disarm() }.isSuccess) seen(null) else synchronized(lock) { blocked = true; owner = Owner.STORAGE_BLOCKED }
    main(Runnable { if (synchronized(lock) { epoch == at }) os.cancel() })
  }
  private fun revision(p: S3AutoPlan) {
    val (e, at, t) = synchronized(lock) {
      // R13: the revision retires every installed lifecycle (an unresolved one too); only a real active run is paused.
      val active = active(); epoch++; unresolved = false; exec?.takeIf { !halted(it) }?.state = "done"; Triple(active, epoch, claim())
    }
    e?.let { lease.end(it); runCatching { queue.pauseAutomatic(it, it.runId) } }
    main(Runnable { schedule(at, t, out(p)) })
  }
  private fun idleProject(p: S3AutoPlan) {
    if (p.wake == null) return
    val at = synchronized(lock) { if (owner != Owner.IDLE) { dirty = true; return }; epoch }
    main(Runnable {
      val pending = try { os.pending() } catch (_: Exception) { return@Runnable }
      val t = synchronized(lock) {
        if (owner != Owner.IDLE || epoch != at) return@Runnable
        if (pending?.get("protocol") == 1 && pending["wake"] == p.wake) { owner = Owner.OS_OWNED; return@Runnable }
        claim()
      }
      schedule(at, t, out(p))
    })
  }
  // Non-execution projection: RESULT_FAILURE is definite (Idle, a later event may project once);
  // a generic throw without the exact nonce is ProjectionUnresolved under OSOwned.
  // R13: exact ticket + epoch before the OS call and when the result is applied; an enum match is not enough.
  private fun schedule(at: Long, t: Any, out: Out.Replace) {
    if (synchronized(lock) { epoch != at || ticket !== t }) return; val result = submit(out)
    synchronized(lock) {
      if (epoch != at || ticket !== t || owner != Owner.REPLACING) return
      ticket = null; owner = if (result == null || result == SUCCESS) Owner.OS_OWNED else Owner.IDLE
      if (result == null) unresolved = true
    }
    resume()
  }
  // Locked: no vault access. Only an already-armed plan, or a >=5 min legacy-recovery wake.
  private fun lockedProjection() {
    val recovery = try {
      if (plan.marked()) { read()?.let(::idleProject); return }
      val snapshot = AndroidS3AutomaticPlan.legacySnapshot(legacy) ?: return
      Out.Replace(snapshot, maxOf(Math.addExact(clock(), DEFER), legacy.getLong("due", 0)), 0)
    } catch (_: Exception) { return }
    val at = synchronized(lock) { if (owner != Owner.IDLE) return; epoch }
    main(Runnable {
      val pending = try { os.pending() } catch (_: Exception) { return@Runnable }
      val t = synchronized(lock) {
        if (owner != Owner.IDLE || epoch != at || pending?.get("protocol") == 0 && pending["wake"] == recovery.wake) return@Runnable
        claim()
      }
      schedule(at, t, recovery)
    })
  }
  companion object { const val DEFER = 300000L; const val SUCCESS = 1 }
}
