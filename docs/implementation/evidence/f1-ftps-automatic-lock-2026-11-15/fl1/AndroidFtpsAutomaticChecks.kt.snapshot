package com.kloda.sync

import android.app.Instrumentation
import android.app.job.JobParameters
import android.app.job.JobScheduler
import android.app.job.JobService
import android.content.Context
import android.content.Intent
import android.database.sqlite.SQLiteDatabase
import android.os.ParcelFileDescriptor
import android.provider.DocumentsContract
import org.json.JSONArray
import org.json.JSONObject
import java.io.File
import java.util.UUID
import java.util.concurrent.CopyOnWriteArrayList

// F1-FTPS acceptance rows on the owned disposable test package only; no Photos, personal sources or network claim.
internal object AndroidFtpsAutomaticChecks {
  fun scope(scope: String?, i: Instrumentation, root: File, group: (String, () -> Unit) -> Unit): String? = when (scope) {
    "ftps-product" -> {
      AndroidFtpsFixture.load(i, root)
      group("ftps-product-factory-service") { AndroidFtpsProductChecks.run(i) }
      group("ftps-owned-os-files") { AndroidFtpsOsChecks.run(i) }
      "FTPS owned product/OS PASS\n"
    }
    "ftps-automatic-lock" -> {
      AndroidFtpsFixture.load(i, root)
      resetRunless(i)
      group("ftps-product-factory-service") { AndroidFtpsProductChecks.run(i) }
      group("ftps-fl1-locked-job-keeps-plan") { owned(i) { app, queue -> lockedJob(i, app, queue) } }
      "FTPS FL1 locked JOB: plan/run/lease kept, single own OS retry, no cancel/reconcile PASS; synthetic denial, not real Keyguard\n"
    }
    else -> null
  }

  private class Recorder : AndroidFtpsScheduler.Os() {
    val finishes = CopyOnWriteArrayList<Pair<Int, Boolean>>()
    val cancels = CopyOnWriteArrayList<Int>()
    override fun finish(service: JobService, params: JobParameters, retry: Boolean) { finishes += params.jobId to retry; super.finish(service, params, retry) }
    override fun cancel(context: Context, id: Int) { cancels += id; super.cancel(context, id) }
  }

  private fun shell(i: Instrumentation, command: String) =
    ParcelFileDescriptor.AutoCloseInputStream(i.uiAutomation.executeShellCommand(command)).use { it.readBytes() }

  private fun busy() = Thread.getAllStackTraces().keys.any { it.isAlive && it.name in setOf("kloda-ftps-job", "kloda-ftps-reconcile") }

  private fun runs(queue: AndroidFtpsQueue) = queue.journal.database.rawQuery("SELECT COUNT(*) FROM ftps_run", null).use { check(it.moveToFirst()); it.getLong(0) }

  /** FL1: due P, run=null, device locked at JOB admission capture. */
  private fun lockedJob(i: Instrumentation, app: Context, queue: AndroidFtpsQueue) {
    val scheduler = app.getSystemService(JobScheduler::class.java)
    val prefs = app.getSharedPreferences("kloda-sync", 0)
    AndroidFtpsScheduler.reconcile(app)
    val pending = checkNotNull(scheduler.getPendingJob(AndroidFtpsScheduler.JOB)) { "no JOB: ${AndroidFtpsScheduler.error(app)}" }
    val token = pending.extras.getString("token")
    val before = checkNotNull(queue.schedule.read())
    check(before.run == null && before.due <= System.currentTimeMillis()) { "precondition P=$before" }
    val runsBefore = runs(queue)
    val recorder = Recorder()
    AndroidFtpsScheduler.os = recorder
    AndroidFtpsQueue.captureFault = { throw FtpsFailure("credential_locked") }
    try {
      shell(i, "cmd jobscheduler run -f com.kloda.sync.test ${AndroidFtpsScheduler.JOB}")
      val deadline = android.os.SystemClock.elapsedRealtime() + 30000
      while (android.os.SystemClock.elapsedRealtime() < deadline && (recorder.finishes.isEmpty() || busy())) Thread.sleep(50)
      Thread.sleep(500)
      check(!busy()) { "callback still running; finishes=${recorder.finishes} cancels=${recorder.cancels}" }
      val after = queue.schedule.read()
      check(after == before) { "P changed: before=$before after=$after" }
      check(runs(queue) == runsBefore) { "runs before=$runsBefore after=${runs(queue)}" }
      val probe = Any()
      check(AndroidFtpsRuntime.beginAutomatic(probe, "fl1-lease-probe") { false }) { "lease still held" }
      AndroidFtpsRuntime.endAutomatic(probe)
      check(recorder.cancels.isEmpty()) { "cancel calls=${recorder.cancels} finishes=${recorder.finishes}" }
      check(recorder.finishes == listOf(AndroidFtpsScheduler.JOB to true)) { "finishes=${recorder.finishes} expected=[(${AndroidFtpsScheduler.JOB}, true)]" }
      check(prefs.getString("ftpsDispatchToken", null) == token) { "dispatch token rotated" }
      check(scheduler.getPendingJob(AndroidFtpsScheduler.JOB)?.extras?.getString("token") == token) { "own JOB not retained for OS backoff" }
    } finally {
      AndroidFtpsQueue.captureFault = null
      AndroidFtpsScheduler.os = AndroidFtpsScheduler.Os()
    }
  }

  /** Removes only this fixture's own profile/DB left by a failed FL check that produced no FTPS run/upload evidence. */
  private fun resetRunless(i: Instrumentation) {
    val app = i.targetContext
    val directory = File(app.noBackupFilesDir, "kloda-ftps")
    val ledger = File(directory, "owned-product-fixture.json"); val db = File(directory, "journal.sqlite")
    val profile = AndroidFtpsVault(app).read() ?: return
    check(ledger.isFile && JSONObject(ledger.readText()).getString("owner") == "kloda-ftps16-product-fixture" && db.isFile)
    check(profile.target.address == "10.0.2.2" && profile.target.username == "probe" && profile.target.root == "/" && profile.password == "unused")
    SQLiteDatabase.openDatabase(db.path, null, SQLiteDatabase.OPEN_READONLY).use { read ->
      for (table in listOf("ftps_run", "ftps_upload")) read.rawQuery("SELECT COUNT(*) FROM $table", null).use { check(it.moveToFirst() && it.getLong(0) == 0L) { "unknown $table evidence kept" } }
    }
    check(SQLiteDatabase.deleteDatabase(db)); ledger.delete()
    android.util.AtomicFile(File(app.noBackupFilesDir, "kloda-ftps-profile.v1")).delete()
    java.security.KeyStore.getInstance("AndroidKeyStore").apply { load(null); deleteEntry(app.packageName + ".ftps.profile.v1") }
    check(directory.listFiles()!!.isEmpty() && directory.delete())
  }

  /** Same owned fixture/teardown discipline as AndroidFtpsOsChecks; unknown native evidence kept on failure. */
  private fun owned(i: Instrumentation, body: (Context, AndroidFtpsQueue) -> Unit) {
    val app = i.targetContext.applicationContext
    check(app.packageName == "com.kloda.sync.test" && android.os.Build.HARDWARE in setOf("ranchu", "goldfish"))
    val prefs = app.getSharedPreferences("kloda-sync", 0)
    val scheduler = app.getSystemService(JobScheduler::class.java)
    val vault = File(app.noBackupFilesDir, "kloda-ftps-profile.v1")
    val snapshots = File(app.noBackupFilesDir, "kloda-ftps-snapshots")
    val keys = java.security.KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
    val alias = app.packageName + ".ftps.profile.v1"
    check(prefs.all.isEmpty() && !vault.exists() && !snapshots.exists() && !keys.containsAlias(alias) && scheduler.allPendingJobs.isEmpty())
    val queue = AndroidFtpsRuntime.queue(app)
    check(!queue.journal.hasProfile())
    val token = UUID.randomUUID().toString().replace("-", "")
    val root = File(app.cacheDir, "kloda-owned-saf-$token")
    check(!root.exists() && root.mkdirs())
    val source = File(root, "source").also { check(it.mkdir()) }
    File(source, "payload.bin").writeBytes(ByteArray(4096) { (it % 251).toByte() })
    val tree = DocumentsContract.buildTreeDocumentUri(AndroidWebDavDocumentsProvider.AUTHORITY, "$token:source")
    var granted = false; var completed = false
    try {
      app.grantUriPermission(app.packageName, tree, Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION or Intent.FLAG_GRANT_PREFIX_URI_PERMISSION)
      app.contentResolver.takePersistableUriPermission(tree, Intent.FLAG_GRANT_READ_URI_PERMISSION); granted = true
      val rows = JSONArray().put(JSONObject().put("id", UUID.randomUUID().toString()).put("reference", tree.toString()))
      check(FilesRunContext.stamp(prefs.edit().putString("directorySources", rows.toString()).putString("backupMode", "live")).commit())
      val hostname = i.context.assets.open("kloda-ftps16/hostname.txt").bufferedReader().use { it.readText().trim() }
      queue.configure(FtpsTarget("10.0.2.2", 27449, hostname, "/", "probe", "native", "native"), "unused")
      body(app, queue)
      completed = true
    } finally {
      runCatching { queue.disable() }; AndroidFtpsScheduler.cancel(app)
      if (granted) {
        app.contentResolver.releasePersistableUriPermission(tree, Intent.FLAG_GRANT_READ_URI_PERMISSION)
        app.revokeUriPermission(tree, Intent.FLAG_GRANT_READ_URI_PERMISSION)
      }
      check(prefs.edit().clear().commit()) // Empty on entry; only this fixture populated these keys.
      check(root.name == "kloda-owned-saf-$token"); root.deleteRecursively()
      if (completed || runCatching { runs(queue) == 0L }.getOrDefault(false)) {
        if (keys.containsAlias(alias)) keys.deleteEntry(alias)
        android.util.AtomicFile(vault).delete()
        queue.journal.database.close()
        val directory = File(app.noBackupFilesDir, "kloda-ftps")
        check(SQLiteDatabase.deleteDatabase(File(directory, "journal.sqlite")))
        File(directory, "owned-product-fixture.json").delete()
        check(directory.listFiles()!!.isEmpty() && directory.delete())
        if (snapshots.exists()) check(snapshots.listFiles()!!.isEmpty() && snapshots.delete())
      }
    }
  }
}
