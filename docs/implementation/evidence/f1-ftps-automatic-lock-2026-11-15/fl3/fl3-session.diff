+  /** Forces the own JOB once and waits until a new callback finished and no FTPS job/reconcile thread is alive. */
+  private fun force(i: Instrumentation, recorder: Recorder) {
+    val seen = recorder.finishes.size
+    shell(i, "cmd jobscheduler run -f com.kloda.sync.test ${AndroidFtpsScheduler.JOB}")
+    val deadline = android.os.SystemClock.elapsedRealtime() + 60000
+    while (android.os.SystemClock.elapsedRealtime() < deadline && (recorder.finishes.size == seen || busy())) Thread.sleep(50)
+    Thread.sleep(500)
+    check(recorder.finishes.size > seen && !busy()) { "no finished callback: finishes=${recorder.finishes} cancels=${recorder.cancels}" }
+  }
+
+  /** FL3 due: after the FL1 locked wait, the next unlocked callback freshly admits the same occurrence with one claim. */
+  private fun unlockedDue(i: Instrumentation, app: Context, queue: AndroidFtpsQueue) {
+    lockedJob(i, app, queue)
+    val before = checkNotNull(queue.schedule.read())
+    check(before.run == null && runs(queue) == 0L) { "precondition P=$before runs=${runs(queue)}" }
+    val recorder = Recorder(); AndroidFtpsScheduler.os = recorder
+    try {
+      force(i, recorder)
+      check(runs(queue) == 1L) { "claims=${runs(queue)} expected exactly one" }
+      val run = checkNotNull(queue.runs.read(automatic = true))
+      check(run.target == before.target && run.binding == before.binding && run.occurrence == before.occurrence && run.phase != "running") {
+        "run=${run.target}/${run.binding}/${run.occurrence}/${run.phase} P=$before"
+      }
+      val after = checkNotNull(queue.schedule.read())
+      check(after.target == before.target && after.binding == before.binding &&
+        ((after.run == run.id && after.occurrence == before.occurrence) || (after.run == null && after.occurrence > before.occurrence))) { "P after=$after" }
+      check(recorder.cancels.isEmpty() && recorder.finishes.all { it == (AndroidFtpsScheduler.JOB to false) }) {
+        "cancel=${recorder.cancels} finish=${recorder.finishes}"
+      }
+    } finally { AndroidFtpsScheduler.os = AndroidFtpsScheduler.Os() }
+  }
+
+  /** FL3 future: a locked then unlocked callback on a future live P never admits it early; P and runs stay equal. */
+  private fun unlockedFuture(i: Instrumentation, app: Context, queue: AndroidFtpsQueue) {
+    val scheduler = app.getSystemService(JobScheduler::class.java)
+    AndroidFtpsScheduler.reconcile(app)
+    AndroidFtpsQueue.captureFault = { throw FtpsFailure("credential_locked") } // Keep a natural latency-0 run on the locked path.
+    val recorder = Recorder(); AndroidFtpsScheduler.os = recorder
+    try {
+      val created = checkNotNull(queue.schedule.read()) { "no P: ${AndroidFtpsScheduler.error(app)}" }
+      check(created.run == null && runs(queue) == 0L) { "precondition P=$created" }
+      val later = System.currentTimeMillis() + 3600000L
+      synchronized(AndroidSyncJournal.sourceLock) { queue.schedule.save(created.copy(occurrence = later, due = later), created) }
+      AndroidFtpsScheduler.reconcile(app) // Locked reconcile re-arms the same future P.
+      val before = checkNotNull(queue.schedule.read())
+      check(before.due == later && before.run == null) { "future P=$before" }
+      force(i, recorder)
+      check(queue.schedule.read() == before && recorder.cancels.isEmpty() && recorder.finishes.all { it == (AndroidFtpsScheduler.JOB to true) }) {
+        "locked: P=${queue.schedule.read()} cancel=${recorder.cancels} finish=${recorder.finishes}"
+      }
+      AndroidFtpsQueue.captureFault = null
+      val seen = recorder.finishes.size
+      force(i, recorder)
+      check(queue.schedule.read() == before) { "P changed: before=$before after=${queue.schedule.read()}" }
+      check(runs(queue) == 0L) { "early claim: runs=${runs(queue)}" }
+      check(recorder.cancels.isEmpty() && recorder.finishes.drop(seen).all { it == (AndroidFtpsScheduler.JOB to false) }) {
+        "cancel=${recorder.cancels} finish=${recorder.finishes}"
+      }
+      check(scheduler.getPendingJob(AndroidFtpsScheduler.JOB)?.extras?.getLong("dispatch", -1) == before.due) { "future JOB not re-armed for P.due" }
+    } finally {
+      AndroidFtpsQueue.captureFault = null
+      AndroidFtpsScheduler.os = AndroidFtpsScheduler.Os()
+    }
+  }
