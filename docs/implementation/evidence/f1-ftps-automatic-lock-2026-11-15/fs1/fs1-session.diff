+  /** Holds the first JOB finish (A's finally) at a barrier; records every OS call made after the release. */
+  private class Gate : AndroidFtpsScheduler.Os() {
+    val entered = java.util.concurrent.CountDownLatch(1)
+    val release = java.util.concurrent.CountDownLatch(1)
+    @Volatile var released = false
+    val late = java.util.concurrent.CopyOnWriteArrayList<String>()
+    override fun finish(service: android.app.job.JobService, params: android.app.job.JobParameters, retry: Boolean) {
+      if (params.jobId == AndroidFtpsScheduler.JOB && entered.count > 0) { entered.countDown(); check(release.await(60, java.util.concurrent.TimeUnit.SECONDS)) }
+      else if (released) late += "finish(${params.jobId},$retry)"
+      super.finish(service, params, retry)
+    }
+    override fun cancel(context: Context, id: Int) { if (released) late += "cancel($id)"; super.cancel(context, id) }
+  }
+
+  /**
+   * FS1 (JOB): A = own JOB callback on a future P, held at its finally barrier; B = newer projection (new P, token, JOB,
+   * distinctive error) installed meanwhile. Released A must not change B's P/token/error/JOB/WATCH nor cancel/reconcile.
+   */
+  private fun staleJobFinally(i: Instrumentation, app: Context, queue: AndroidFtpsQueue) {
+    val scheduler = app.getSystemService(JobScheduler::class.java)
+    val prefs = app.getSharedPreferences("kloda-sync", 0)
+    val gate = Gate()
+    try {
+      val armed = future(app, queue)
+      AndroidFtpsQueue.captureFault = null // A: open device, P not due → no claim, ordinary finally.
+      AndroidFtpsScheduler.os = gate
+      AndroidFtpsAutomaticChecks.shell(i, "cmd jobscheduler run -f com.kloda.sync.test ${AndroidFtpsScheduler.JOB}")
+      check(gate.entered.await(30, java.util.concurrent.TimeUnit.SECONDS)) { "A never reached its finally" }
+      // B: newer P and projection while A is held (locked reconcile → new token/JOB, error credential_locked).
+      AndroidFtpsQueue.captureFault = { throw FtpsFailure("credential_locked") }
+      val later = armed.plan.due + 600000L
+      synchronized(AndroidSyncJournal.sourceLock) { queue.schedule.save(armed.plan.copy(occurrence = later, due = later), armed.plan) }
+      AndroidFtpsScheduler.reconcile(app)
+      val b = checkNotNull(queue.schedule.read()); val bToken = prefs.getString("ftpsDispatchToken", null)
+      val bJob = checkNotNull(scheduler.getPendingJob(AndroidFtpsScheduler.JOB)) { "B JOB missing" }
+      check(b.due == later && bToken != armed.token && bJob.extras.getString("token") == bToken) { "B not installed: P=$b" }
+      check(AndroidFtpsScheduler.error(app) == "credential_locked") { "B error=${AndroidFtpsScheduler.error(app)}" }
+      val bWatch = scheduler.getPendingJob(AndroidFtpsScheduler.WATCH)?.extras?.getString("token")
+      // Any reconcile by A would now fail closed (cancel + report) and so become visible.
+      AndroidFtpsQueue.captureFault = { throw SecurityException("fs1 synthetic capture failure") }
+      gate.released = true; gate.release.countDown()
+      val deadline = android.os.SystemClock.elapsedRealtime() + 30000
+      Thread.sleep(500)
+      while (AndroidFtpsAutomaticChecks.busy() && android.os.SystemClock.elapsedRealtime() < deadline) Thread.sleep(50)
+      Thread.sleep(500)
+      check(!AndroidFtpsAutomaticChecks.busy()) { "A still running" }
+      check(gate.late.isEmpty()) { "A late OS calls=${gate.late}" }
+      check(queue.schedule.read() == b && AndroidFtpsAutomaticChecks.runs(queue) == 0L) { "B P changed: $b → ${queue.schedule.read()}" }
+      check(prefs.getString("ftpsDispatchToken", null) == bToken &&
+        scheduler.getPendingJob(AndroidFtpsScheduler.JOB)?.extras?.getString("token") == bToken) { "B JOB/token changed" }
+      check(AndroidFtpsScheduler.error(app) == "credential_locked") { "B error overwritten: ${AndroidFtpsScheduler.error(app)}" }
+      check(scheduler.getPendingJob(AndroidFtpsScheduler.WATCH)?.extras?.getString("token") == bWatch) { "B WATCH changed" }
+    } finally { gate.release.countDown(); restore() }
+  }
